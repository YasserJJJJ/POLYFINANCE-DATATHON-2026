    <script>
      document.addEventListener("DOMContentLoaded", function () {
        var pubInfos = document.querySelectorAll(".pub-info");
        for (var i = 0; i < pubInfos.length; i++) {
          var numSpan = document.createElement("span");
          numSpan.className = "pub-number";
          numSpan.innerHTML = i + 1 + ". ";
          pubInfos[i].insertBefore(numSpan, pubInfos[i].firstChild);
        }
      });
    </script>
