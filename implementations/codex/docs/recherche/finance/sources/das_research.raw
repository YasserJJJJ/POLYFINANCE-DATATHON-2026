<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sanjiv Ranjan Das — Research & Publications</title>
    <style>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      body {
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        color: #2d2d2d;
        background: #f5f5f0;
        line-height: 1.6;
      }
      .logo-bar {
        text-align: center;
        padding: 2rem 2rem 0;
      }
      .logo-bar img {
        max-width: 280px;
        height: auto;
      }
      .container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 2.5rem 2rem 3rem;
        display: grid;
        grid-template-columns: 280px 1fr;
        gap: 3rem;
      }
      .sidebar {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
      }
      .photo-card {
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
      }
      .photo-card img {
        width: 100%;
        display: block;
      }
      .main-content {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
      }
      .hero-card {
        background: #fff;
        border-radius: 16px;
        padding: 2rem 2.5rem;
        box-shadow: 0 2px 16px rgba(0, 0, 0, 0.06);
      }
      .hero-card h2 {
        font-size: 1.6rem;
        font-weight: 700;
        color: #1a1a2e;
        margin-bottom: 0.3rem;
      }
      .quick-links {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }
      .quick-links a {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.6rem 1.2rem;
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 10px;
        text-decoration: none;
        color: #1a1a2e;
        font-weight: 500;
        font-size: 0.93rem;
        transition:
          border-color 0.2s,
          box-shadow 0.2s,
          background 0.2s;
      }
      .quick-links a:hover {
        border-color: #1a1a2e;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        background: #fafaf6;
      }
      .quick-links .icon {
        font-size: 1.15rem;
      }
      footer {
        text-align: center;
        padding: 2rem 1rem 1.5rem;
        color: #999;
        font-size: 0.82rem;
      }

      details {
        margin-bottom: 1.2rem;
        background: #fff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
        border: 1px solid #eee;
      }
      summary {
        padding: 1.2rem 1.5rem;
        font-weight: 700;
        font-size: 1.1rem;
        cursor: pointer;
        background: #fff;
        border-bottom: 1px solid transparent;
        list-style: none;
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: #1a1a2e;
      }
      summary::-webkit-details-marker {
        display: none;
      }
      summary::after {
        content: "⊕";
        font-size: 1.4rem;
        color: #888;
      }
      details[open] summary {
        border-bottom: 1px solid #eee;
      }
      details[open] summary::after {
        content: "⊖";
      }

      .details-content {
        padding: 1.5rem;
        background: #fafaf6;
      }

      .pub-card {
        display: flex;
        gap: 1.5rem;
        background: #fff;
        border-radius: 10px;
        padding: 1.2rem;
        margin-bottom: 1rem;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.03);
        border: 1px solid #eee;
        align-items: flex-start;
      }
      .pub-card img {
        width: 50px;
        height: auto;
        object-fit: contain;
        flex-shrink: 0;
        border: 1px solid #eee;
        padding: 2px;
        background: #fff;
      }
      .pub-info {
        flex-grow: 1;
        font-size: 0.95rem;
      }
      .pub-number {
        font-weight: 700;
        color: #1a1a2e;
        margin-right: 0.3rem;
      }
      .pub-info a {
        color: #1a1a2e;
        text-decoration: underline;
        text-underline-offset: 2px;
      }
      .pub-info i {
        color: #555;
      }

      @media (max-width: 760px) {
        .container {
          grid-template-columns: 1fr;
          padding: 1.5rem 1rem;
          gap: 2rem;
        }
        .sidebar {
          align-items: center;
        }
        .photo-card {
          max-width: 200px;
        }
        .pub-card {
          flex-direction: column;
          align-items: flex-start;
          gap: 1rem;
        }
        .pub-card img {
          width: 60px;
        }
      }
    </style>
  </head>
