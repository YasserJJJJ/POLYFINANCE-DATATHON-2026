<span id="A9.T30.p1.1" class="ltx_p"><span id="A9.T30.p1.1.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#FF8000;"> Ground truth claims:</span></span>
</span></span></td></tr>
<tr id="A9.T30.2.14" class="ltx_tr">
<td id="A9.T30.2.14.1" class="ltx_td ltx_align_left ltx_align_top"><span id="A9.T30.2.14.1.1" class="ltx_inline-logical-block ltx_align_top" style="width:327.8pt;">
