</div>
<div id="lstnumberx345" class="ltx_listingline"><span id="lstnumberx345.1" class="ltx_text ltx_font_typewriter">&gt;</span><span id="lstnumberx345.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx345.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">percent_of_hip_hop_dance</span><span id="lstnumberx345.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx345.5" class="ltx_text ltx_font_typewriter">=</span><span id="lstnumberx345.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx345.7" class="ltx_text ltx_font_typewriter">100</span><span id="lstnumberx345.8" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx345.9" class="ltx_text ltx_font_typewriter">-</span><span id="lstnumberx345.10" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx345.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter">percent_of_contemporary_dance</span><span id="lstnumberx345.12" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx345.13" class="ltx_text ltx_font_typewriter">-</span><span id="lstnumberx345.14" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx345.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter">percent_of_jazz_dance</span>
</div>
