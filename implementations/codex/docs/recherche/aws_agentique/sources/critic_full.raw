920.90" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx920.91" class="ltx_text ltx_lst_identifier ltx_font_typewriter">a</span><span id="lstnumberx920.92" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx920.93" class="ltx_text ltx_lst_identifier ltx_font_typewriter">month</span><span id="lstnumberx920.94" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx920.95" class="ltx_text ltx_lst_identifier ltx_font_typewriter">and</span><span id="lstnumberx920.96" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx920.97" class="ltx_text ltx_font_typewriter">8</span><span id="lstnumberx920.98" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx920.99" class="ltx_text ltx_lst_identifier ltx_font_typewriter">hours</span><span id="lstnumberx920.100" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx920.101" class="ltx_text ltx_lst_identifier ltx_font_typewriter">a</span><span id="lstnumberx920.102" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx920.103" class="ltx_text ltx_lst_identifier ltx_font_typewriter">day</span><span id="lstnumberx920.104" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx920.105" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx920.106" class="ltx_text ltx_lst_identifier ltx_font_typewriter">how</span><span id="lstnumberx920.107" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx920.108" class="ltx_text ltx_lst_identifier ltx_font_typewriter">much</span><span id="lstnumberx920.109" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx920.110" class="ltx_text ltx_lst_identifier ltx_font_typewriter">does</span><span id="lstnumberx920.111" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx920.112" class="ltx_text ltx_lst_iden