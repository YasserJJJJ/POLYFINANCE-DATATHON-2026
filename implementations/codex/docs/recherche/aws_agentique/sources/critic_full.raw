<div id="lstnumberx317" class="ltx_listingline"><span id="lstnumberx317.1" class="ltx_text ltx_font_typewriter" style="--ltx-bg-color:#C4EA70;"># Calculate the number of guests needed to make the two venues equal in cost</span>
</div>
<div id="lstnumberx318" class="ltx_listingline"><span id="lstnumberx318.1" class="ltx_text ltx_font_typewriter" style="--ltx-bg-color:#C4EA70;">num_of_guests = math.ceil(flat_fee / (cost_per_person - cost_of_food_per_person))</span>
</div>
<div id="lstnumberx319" class="ltx_listingline"><span id="lstnumberx319.1" class="ltx_text ltx_font_typewriter" style="--ltx-bg-color:#C4EA70;">answer = num_of_guests</span>
</div>
<div id="lstnumberx320" class="ltx_listingline"><span id="lstnumberx320.1" class="ltx_text ltx_font_typewriter">‘‘‘</span>
</div>
<div id="lstnumberx321" class="ltx_listingline"><span id="lstnumberx321.1" class="ltx_text ltx_font_typewriter" style="--ltx-bg-color:#76D6FF;">Execution:</span><span id="lstnumberx321.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx321.3" class="ltx_text ltx_font_typewriter" style="--ltx-bg-color:#FFD579;">Done</span>
</div>
<div id="lstnumberx322" class="ltx_listingline"><span id="lstnumberx322.1" class="ltx_text ltx_font_typewriter" style="--ltx-bg-color:#76D6FF;">Output:</span><span id="lstnumberx322.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx322.3" class="ltx_text ltx_font_typewriter" style="--ltx-bg-color:#FFD579;">answer = 10.0</span>
</div>
<div id="lstnumberx323" class="ltx_listingline"><span id="lstnumberx323.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Gold</span><span id="lstnumberx323.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx323.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Answer</span><span id="lstnumberx323.4" class="ltx_text ltx_font_typewriter">:</span><span id="lstnumberx323.5" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx323.6" class="ltx_text ltx_font_typewriter">10.0</span>
</div>
<div id="lstnumberx324" class="ltx_listingline"><span id="lstnumberx324.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Is</span><span id="lstnumberx324.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx324.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">correct</span><span id="lstnumberx324.4" class="ltx_text ltx_font_typewriter">:</span><span id="lstnumberx324.5" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx324.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter">True</span>
</div>
</div>
</figure>
</section>
