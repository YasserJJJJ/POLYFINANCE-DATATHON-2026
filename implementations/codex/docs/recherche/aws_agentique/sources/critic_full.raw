<div id="lstnumberx42" class="ltx_listingline"><span id="lstnumberx42.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Question</span><span id="lstnumberx42.2" class="ltx_text ltx_font_typewriter">:</span><span id="lstnumberx42.3" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx42.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Which</span><span id="lstnumberx42.5" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx42.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter">performance</span><span id="lstnumberx42.7" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx42.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter">act</span><span id="lstnumberx42.9" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx42.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter">has</span><span id="lstnumberx42.11" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx42.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter">a</span><span id="lstnumberx42.13" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx42.14" class="ltx_text ltx_lst_identifier ltx_font_typewriter">higher</span><span id="lstnumberx42.15" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx42.16" class="ltx_text ltx_lst_identifier ltx_font_typewriter">instrument</span><span id="lstnumberx42.17" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx42.18" class="ltx_text ltx_lst_identifier ltx_font_typewriter">to</span><span id="lstnumberx42.19" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx42.20" class="ltx_text ltx_lst_identifier ltx_font_typewriter">person</span><span id="lstnumberx42.21" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx42.22" class="ltx_text ltx_lst_identifier ltx_font_type