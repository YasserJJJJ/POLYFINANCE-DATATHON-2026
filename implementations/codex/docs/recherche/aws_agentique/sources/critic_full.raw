dentifier ltx_font_typewriter">How</span><span id="lstnumberx210.159" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx210.160" class="ltx_text ltx_lst_identifier ltx_font_typewriter">many</span><span id="lstnumberx210.161" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx210.162" class="ltx_text ltx_lst_identifier ltx_font_typewriter">total</span><span id="lstnumberx210.163" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx210.164" class="ltx_text ltx_lst_identifier ltx_font_typewriter">fruits</span><span id="lstnumberx210.165" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx210.166" class="ltx_text ltx_lst_identifier ltx_font_typewriter">can</span><span id="lstnumberx210.167" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx210.168" class="ltx_text ltx_lst_identifier ltx_font_typewriter">an</span><span id="lstnumberx210.169" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx210.170" class="ltx_text ltx_lst_identifier ltx_font_typewriter">avocado</span><span id="lstnumberx210.171" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx210.172" class="ltx_text ltx_lst_identifier ltx_font_typewriter">tree</span><span id="lstnumberx210.173" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx210.174" class="ltx_text ltx_lst_identifier ltx_font_typewriter">produce</span><span id="lstnumberx210.175" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx210.176" class="ltx_text ltx_lst_identifier ltx_font_typewriter">during</span><span id="lstnumberx210.177" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx210.178" class="ltx_text ltx_lst_identifier ltx_font_typewriter">its</span><span id="lstnumberx210.179" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx210.