<div id="lstnumberx211" class="ltx_listingline"><span id="lstnumberx211.1" class="ltx_text ltx_font_typewriter">‘‘‘</span><span id="lstnumberx211.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter">python</span>
</div>
<div id="lstnumberx212" class="ltx_listingline"><span id="lstnumberx212.1" class="ltx_text ltx_font_typewriter" style="--ltx-bg-color:#F47874;">initial_fruits = 50</span>
</div>
<div id="lstnumberx213" class="ltx_listingline"><span id="lstnumberx213.1" class="ltx_text ltx_font_typewriter" style="--ltx-bg-color:#F47874;">num_of_fruits_in_6th_year = 3 * initial_fruits</span>
</div>
<div id="lstnumberx214" class="ltx_listingline"><span id="lstnumberx214.1" class="ltx_text ltx_font_typewriter" style="--ltx-bg-color:#F47874;">num_of_fruits_in_7th_year = 7 * initial_fruits</span>
</div>
<div id="lstnumberx215" class="ltx_listingline"><span id="lstnumberx215.1" class="ltx_text ltx_font_typewriter" style="--ltx-bg-color:#F47874;">num_of_fruits_in_8th_year = num_of_fruits_in_10th_year - 200</span>
</div>
<div id="lstnumberx216" class="ltx_listingline"><span id="lstnumberx216.1" class="ltx_text ltx_font_typewriter" style="--ltx-bg-color:#F47874;">num_of_fruits_in_10th_year = 20 * initial_fruits</span>
</div>
<div id="lstnumberx217" class="ltx_listingline"><span id="lstnumberx217.1" class="ltx_text ltx_font_typewriter" style="--ltx-bg-color:#F47874;">answer = initial_fruits + num_of_fruits_in_6th_year + num_of_fruits_in_7th_year + num_of_fruits_in_8th_year + num_of_fruits_in_10th_year</span>
</div>
<div id="lstnumberx218" class="ltx_listingline"><span id="lstnumberx218.1" class="ltx_text ltx_font_typewriter">‘‘‘</span>
</div>
