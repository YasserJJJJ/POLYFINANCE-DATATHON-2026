</div>
<div id="lstnumberx257" class="ltx_listingline"><span id="lstnumberx257.1" class="ltx_text ltx_font_typewriter" style="--ltx-bg-color:#F47874;">answer = (cost_per_person + cost_of_food_per_person) * x == flat_fee + cost_of_food_per_person * x</span>
</div>
<div id="lstnumberx258" class="ltx_listingline"><span id="lstnumberx258.1" class="ltx_text ltx_font_typewriter" style="--ltx-bg-color:#F47874;">answer = flat_fee / (cost_per_person + cost_of_food_per_person - cost_of_food_per_person)</span>
</div>
