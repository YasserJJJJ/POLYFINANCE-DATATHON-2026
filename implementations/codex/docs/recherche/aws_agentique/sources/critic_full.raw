<div id="lstnumberx1433" class="ltx_listingline"><span id="lstnumberx1433.1" class="ltx_text ltx_font_typewriter">(</span><span id="lstnumberx1433.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter">B</span><span id="lstnumberx1433.3" class="ltx_text ltx_font_typewriter">)</span><span id="lstnumberx1433.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1433.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter">False</span>
</div>
