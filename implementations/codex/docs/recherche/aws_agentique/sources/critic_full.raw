<section id="A6.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">F.3 </span>Toxicity Reduction</h3>

<div id="A6.SS3.p1" class="ltx_para ltx_noindent">
<p id="A6.SS3.p1.1" class="ltx_p"><em id="A6.SS3.p1.1.1" class="ltx_emph ltx_font_italic" style="--ltx-fg-color:#FF0000;"><span id="A6.SS3.p1.1.1.1" class="ltx_text ltx_font_bold">Warning</span>: this section contains (LLMs generated) content that may be offensive or sensitive.</em></p>
</div>
<div id="A6.SS3.p2" class="ltx_para ltx_noindent">
<p id="A6.SS3.p2.1" class="ltx_p">Here we present the full prompts of <span id="A6.SS3.p2.1.1" class="ltx_text ltx_font_smallcaps">CRITIC</span> and <span id="A6.SS3.p2.1.2" class="ltx_text ltx_font_smallcaps">CRITIC</span> w/o Tool for toxicity reduction.</p>
</div>
<section id="A6.SS3.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">F.3.1 </span><span id="A6.SS3.SSS1.2" class="ltx_text ltx_font_smallcaps">CRITIC</span> </h4>

<figure id="LST22" class="ltx_float ltx_lstlisting">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float">Listing 22: </span>Prompts for <span id="LST22.3" class="ltx_text ltx_font_smallcaps">CRITIC</span> on toxicity reduction.</figcaption>
<div id="LST22.4" class="ltx_listing ltx_lstlisting ltx_framed ltx_framed_topbottom ltx_listing"><div class="ltx_listing_data"><a href="data:text/plain;base64," download="sections/appendix/prompts/toxicity.md">⬇</a></div>
<div id="lstnumberx1156" class="ltx_listingline"><span id="lstnumberx1156.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Give</span><span id="lstnumberx1156.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1156.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">a</span><span id="lstnumberx1156.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1156.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter">new</span><span id="lstnumberx1156.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1156.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter">healthier</span><span id="lstnumberx1156.8" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx1156.9" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1156.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter">safer</span><span id="lstnumberx1156.11" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1156.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter">continuation</span><span id="lstnumberx1156.13" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1156.14" class="ltx_text ltx_lst_identifier ltx_font_typewriter">that</span><span id="lstnumberx1156.15" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1156.16" class="ltx_text ltx_lst_identifier ltx_font_typewriter">does</span><span id="lstnumberx1156.17" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1156.18" class="ltx_text ltx_lst_identifier ltx_font_typewriter">not</span><span id="lstnumberx1156.19" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1156.20" class="ltx_text ltx_lst_identifier ltx_font_typewriter">contain</span><span id="lstnumberx1156.21" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1156.22" class="ltx_text ltx_lst_identifier ltx_font_typewriter">severe</span><span id="lstnumberx1156.23" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1156.24" class="ltx_text ltx_lst_identifier ltx_font_typewriter">toxicity</span><span id="lstnumberx1156.25" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx1156.26" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1156.27" class="ltx_text ltx_lst_identifier ltx_font_typewriter">insult</span><span id="lstnumberx1156.28" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx1156.29" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1156.30" class="ltx_text ltx_lst_identifier ltx_font_typewriter">profanity</span><span id="lstnumberx1156.31" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx1156.32" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1156.33" class="ltx_text ltx_lst_identifier ltx_font_typewriter">identity</span><span id="lstnumberx1156.34" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1156.35" class="ltx_text ltx_lst_identifier ltx_font_typewriter">attack</span><span id="lstnumberx1156.36" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx1156.37" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1156.38" class="ltx_text ltx_lst_identifier ltx_font_typewriter">threat</span><span id="lstnumberx1156.39" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1156.40" class="ltx_text ltx_lst_identifier ltx_font_typewriter">and</span><span id="lstnumberx1156.41" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1156.42" class="ltx_text ltx_lst_identifier ltx_font_typewriter">sexually</span><span id="lstnumberx1156.43" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1156.44" class="ltx_text ltx_lst_identifier ltx_font_typewriter">explicit</span><span id="lstnumberx1156.45" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx1156.46" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1156.47" class="ltx_text ltx_lst_identifier ltx_font_typewriter">etc</span><span id="lstnumberx1156.48" class="ltx_text ltx_font_typewriter">.</span><span id="lstnumberx1156.49" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1156.50" class="ltx_text ltx_lst_identifier ltx_font_typewriter">You</span><span id="lstnumberx1156.51" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1156.52" class="ltx_text ltx_font_typewriter">**</span><span id="lstnumberx1156.53" class="ltx_text ltx_lst_identifier ltx_font_typewriter">can</span><span id="lstnumberx1156.54" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1156.55" class="ltx_text ltx_lst_identifier ltx_font_typewriter">not</span><span id="lstnumberx1156.56" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1156.57" class="ltx_text ltx_lst_identifier ltx_font_typewriter">repeat</span><span id="lstnumberx1156.58" class="ltx_text ltx_font_typewriter">**</span><span id="lstnumberx1156.59" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1156.60" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx1156.61" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1156.62" class="ltx_text ltx_lst_identifier ltx_font_typewriter">previous</span><span id="lstnumberx1156.63" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1156.64" class="ltx_text ltx_lst_identifier ltx_font_typewriter">toxic</span><span id="lstnumberx1156.65" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1156.66" class="ltx_text ltx_lst_identifier ltx_font_typewriter">text</span><span id="lstnumberx1156.67" class="ltx_text ltx_font_typewriter">.</span>
</div>
