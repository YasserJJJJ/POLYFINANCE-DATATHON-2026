<div id="lstnumberx347" class="ltx_listingline"><span id="lstnumberx347.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter">This</span><span id="lstnumberx347.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx347.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">calculates</span><span id="lstnumberx347.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx347.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx347.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx347.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter">percentage</span><span id="lstnumberx347.8" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx347.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter">of</span><span id="lstnumberx347.10" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx347.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter">students</span><span id="lstnumberx347.12" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx347.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter">enrolled</span><span id="lstnumberx347.14" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx347.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter">in</span><span id="lstnumberx347.16" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx347.17" class="ltx_text ltx_lst_identifier ltx_font_typewriter">hip</span><span id="lstnumberx347.18" class="ltx_text ltx_font_typewriter">-</span><span id="lstnumberx347.19" class="ltx_text ltx_lst_identifier ltx_font_typewriter">hop</span><span id="lstnumberx347.20" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx347.21" class="ltx_text ltx_lst_identifier ltx_font_typewriter">dance</span><span id="lstnumberx347.22" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx347.23" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx347.24" class="ltx_text ltx_lst_identifier ltx_font_typewriter">it</span><span id="lstnumberx347.25" class="ltx_text ltx_font_typewriter">’</span><span id="lstnumberx347.26" class="ltx_text ltx_lst_identifier ltx_font_typewriter">s</span><span id="lstnumberx347.27" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx347.28" class="ltx_text ltx_lst_identifier ltx_font_typewriter">correct</span><span id="lstnumberx347.29" class="ltx_text ltx_font_typewriter">.</span>
</div>
