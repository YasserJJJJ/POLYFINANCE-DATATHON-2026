<td id="S4.T1.2.1.10.4" class="ltx_td ltx_nopad_l ltx_nopad_r" style="padding-left:4.0pt;padding-right:4.0pt;"></td>
<td id="S4.T1.2.1.10.5" class="ltx_td ltx_nopad_l ltx_nopad_r" style="padding-left:4.0pt;padding-right:4.0pt;"></td>
<td id="S4.T1.2.1.10.6" class="ltx_td ltx_nopad_l ltx_nopad_r" style="padding-left:4.0pt;padding-right:4.0pt;"></td>
<td id="S4.T1.2.1.10.7" class="ltx_td ltx_nopad_l ltx_nopad_r" style="padding-left:4.0pt;padding-right:4.0pt;"></td>
<td id="S4.T1.2.1.10.8" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left" style="padding-left:4.0pt;padding-right:4.0pt;">✓</td></tr>
<tr id="S4.T1.2.1.11" class="ltx_tr">
<td id="S4.T1.2.1.11.1" class="ltx_td ltx_align_left" style="padding-left:4.0pt;padding-right:4.0pt;">§<a href="#S4.SS9" title="4.9 Medical Diagnosis via an LLM Intermediary ‣ 4 Case Studies ‣ Design Patterns for Securing LLM Agentsagainst Prompt Injections" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.9</span></a></td>
<td id="S4.T1.2.1.11.2" class="ltx_td ltx_align_left" style="padding-left:4.0pt;padding-right:4.0pt;">Medical Diagnosis Chatbot</td>
<td id="S4.T1.2.1.11.3" class="ltx_td ltx_nopad_r" style="padding-left:4.0pt;padding-right:4.0pt;"></td>
<td id="S4.T1.2.1.11.4" class="ltx_td ltx_nopad_l ltx_nopad_r" style="padding-left:4.0pt;padding-right:4.0pt;"></td>
<td id="S4.T1.2.1.11.5" class="ltx_td ltx_nopad_l ltx_nopad_r" style="padding-left:4.0pt;padding-right:4.0pt;"></td>
<td id="S4.T1.2.1.11.6" class="ltx_td ltx_nopad_l ltx_nopad_r" style="padding-left:4.0pt;padding-right:4.0pt;"></td>
<td id="S4.T1.2.1.11.7" class="ltx_td ltx_nopad_l ltx_nopad_r" style="padding-left:4.0pt;padding-right:4.0pt;"></td>
