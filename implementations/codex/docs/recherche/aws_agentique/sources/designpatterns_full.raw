<td id="S4.T1.2.1.8.6" class="ltx_td ltx_nopad_l ltx_nopad_r" style="padding-left:4.0pt;padding-right:4.0pt;"></td>
<td id="S4.T1.2.1.8.7" class="ltx_td ltx_nopad_l ltx_nopad_r" style="padding-left:4.0pt;padding-right:4.0pt;"></td>
<td id="S4.T1.2.1.8.8" class="ltx_td ltx_nopad_l ltx_nopad_r" style="padding-left:4.0pt;padding-right:4.0pt;"></td></tr>
<tr id="S4.T1.2.1.9" class="ltx_tr">
<td id="S4.T1.2.1.9.1" class="ltx_td ltx_align_left" style="padding-left:4.0pt;padding-right:4.0pt;">§<a href="#S4.SS7" title="4.7 Resume Screening Assistant ‣ 4 Case Studies ‣ Design Patterns for Securing LLM Agentsagainst Prompt Injections" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.7</span></a></td>
